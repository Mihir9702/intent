  {
    "id": "EVAL-04",
    "name": "Multi-Stage Migration Dependency Cycle Detection",
    "description": "Multi-operation database migration where operations have an accidental dependency loop. Compiler must detect the cycle with E426.",
    "task": {
      "version": "0.3",
      "statements": [
        {
          "kind": "verification",
          "propositions": [{ "path": "db.migrated", "raw": "db.migrated" }],
          "line": 1
        },
        {
          "kind": "done",
          "propositions": [{ "path": "tests", "value": "pass", "raw": "tests=pass" }],
          "line": 2
        }
      ],
      "semantics": {
        "ontology": "intent-core/0.1",
        "entities": [
          { "id": "users_table", "kind": "record", "resolution": "resolved" },
          { "id": "auth_service", "kind": "service", "resolution": "resolved" }
        ],
        "operations": [
          {
            "id": "step_a",
            "kind": "update",
            "target": "users_table",
            "arguments": [],
            "dependsOn": ["step_b"]
          },
          {
            "id": "step_b",
            "kind": "execute",
            "target": "auth_service",
            "arguments": [],
            "dependsOn": ["step_a"]
          }
        ]
      }
    },
    "expectedOk": false,
    "expectedDiagnostics": ["E426"]
  },
  {
