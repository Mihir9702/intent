[
  {
    "id": "EVAL-01",
    "name": "Ambiguous Entity Binding with Dependent Deletion",
    "description": "Natural language instruction 'Replace old document with corrected version, then delete old one' where 'old one' is ambiguous. Deterministic compiler must catch ambiguity and block destructive delete.",
    "input": "examples/ambiguous-replace-delete.intent.json",
    "expectedOk": false,
    "expectedDiagnostics": ["E403"]
  },
  {
    "id": "EVAL-02",
    "name": "Immutable Historical Document Invariant Protection",
    "description": "Attempt to update or delete a historical document when inherited project policy specifies historical_documents.mutable=false.",
    "task": {
      "version": "0.3",
      "statements": [
        {
          "kind": "verification",
          "propositions": [{ "path": "audit.snapshot", "raw": "audit.snapshot" }],
          "line": 1
        },
        {
          "kind": "done",
          "propositions": [{ "path": "tests", "value": "pass", "raw": "tests=pass" }],
          "line": 2
        }
      ],
      "semantics": {
        "ontology": "intent-core/0.1",
        "entities": [
          {
            "id": "tax_invoice_2024",
            "kind": "document",
            "type": "archive.historical_documents",
            "resolution": "resolved"
          }
        ],
        "operations": [
          {
            "id": "delete_tax_invoice",
            "kind": "delete",
            "target": "tax_invoice_2024",
            "arguments": [],
            "dependsOn": []
          }
        ]
      }
    },
    "inherit": ["examples/project.intent"],
    "expectedOk": false,
    "expectedDiagnostics": ["E202"]
  },
  {
    "id": "EVAL-03",
