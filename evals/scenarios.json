  {
    "id": "EVAL-09",
    "name": "Conflicting Security Constraints Rejection",
    "description": "Program contains mutually contradictory security constraints: server_side vs client_side enforcement on permission_checks. E117 must be emitted.",
    "task": {
      "version": "0.3",
      "statements": [
        {
          "kind": "constraint",
          "propositions": [{ "path": "permission_checks.enforcement", "value": "server_side", "raw": "permission_checks.enforcement=server_side" }],
          "line": 1
        },
        {
          "kind": "constraint",
          "propositions": [{ "path": "permission_checks.enforcement", "value": "client_side", "raw": "permission_checks.enforcement=client_side" }],
          "line": 2
        },
        {
          "kind": "verification",
          "propositions": [{ "path": "v", "raw": "v" }],
          "line": 3
        },
        {
          "kind": "done",
          "propositions": [{ "path": "d", "raw": "d" }],
          "line": 4
        }
      ]
    },
    "expectedOk": false,
    "expectedDiagnostics": ["E117"]
  },
  {
    "id": "EVAL-10",
    "name": "Universal Wildcard Invariant Protection",
    "description": "Policy defines universal wildcard invariant *.delete=never. Any delete operation targeting any entity kind must be caught and blocked.",
    "task": {
      "version": "0.3",
      "statements": [
        {
          "kind": "invariant",
          "propositions": [{ "path": "*.delete", "value": "never", "raw": "*.delete=never" }],
          "line": 1
        },
        {
          "kind": "verification",
          "propositions": [{ "path": "v", "raw": "v" }],
          "line": 2
        },
        {
          "kind": "done",
          "propositions": [{ "path": "d", "raw": "d" }],
          "line": 3
        }
      ],
      "semantics": {
        "ontology": "intent-core/0.1",
        "entities": [
          { "id": "scratch_buffer", "kind": "resource", "resolution": "resolved" }
        ],
        "operations": [
          {
            "id": "cleanup_scratch",
            "kind": "delete",
            "target": "scratch_buffer",
            "arguments": [],
            "dependsOn": []
          }
        ]
      }
    },
    "expectedOk": false,
    "expectedDiagnostics": ["E202"]
  },
