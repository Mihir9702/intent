      "version": "0.3",
      "statements": [
        {
          "kind": "verification",
          "propositions": [{ "path": "verify.schema", "raw": "verify.schema" }],
          "line": 1
        },
        {
          "kind": "done",
          "propositions": [{ "path": "tests", "value": "pass", "raw": "tests=pass" }],
          "line": 2
        }
      ],
      "semantics": {
        "ontology": "intent-core/0.1",
        "entities": [
          {
            "id": "ledger_entry",
            "kind": "record",
            "type": "accounting.ledger",
            "resolution": "resolved"
          },
          {
            "id": "scanned_receipt",
            "kind": "file",
