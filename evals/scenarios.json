  {
    "id": "EVAL-07",
    "name": "Unlink Argument Invariant Protection",
    "description": "Unlinking an entity from an audit log protected by historical immutability invariant. The target is an order, but argument 'related' is protected audit_log.",
    "task": {
      "version": "0.3",
      "statements": [
        {
          "kind": "invariant",
          "propositions": [{ "path": "audit_log.mutable", "value": false, "raw": "audit_log.mutable=false" }],
          "line": 1
        },
        {
          "kind": "verification",
          "propositions": [{ "path": "v", "raw": "v" }],
          "line": 2
        },
        {
          "kind": "done",
          "propositions": [{ "path": "d", "raw": "d" }],
          "line": 3
        }
      ],
      "semantics": {
        "ontology": "intent-core/0.1",
        "entities": [
          { "id": "sales_order", "kind": "record", "resolution": "resolved" },
          { "id": "audit_log", "kind": "record", "resolution": "resolved" }
        ],
        "operations": [
          {
            "id": "unlink_from_audit",
            "kind": "unlink",
            "target": "sales_order",
            "arguments": [{ "role": "related", "entity": "audit_log" }],
            "dependsOn": []
          }
        ]
      }
    },
    "expectedOk": false,
    "expectedDiagnostics": ["E202"]
  },
